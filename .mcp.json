{
  "mcpServers": {
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": { "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}" }
    },
    "nanobanana": {
      "type": "stdio",
      "command": "uvx",
      "args": ["nanobanana-mcp-server@latest"],
      "env": { "GEMINI_API_KEY": "${GEMINI_API_KEY}" }
    },
    "notebooklm-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "notebooklm-mcp-cli", "notebooklm-mcp"]
    }
  }
}
